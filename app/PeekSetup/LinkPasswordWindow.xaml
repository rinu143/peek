<Window x:Class="PeekSetup.LinkPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Link Windows Password"
        Width="460"
        Height="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
        Topmost="True">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Link Windows Password"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,4" />
            <TextBlock x:Name="TargetUserText"
                       Text="Account: Domain\User"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Explanation card -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16"
                Margin="0,0,0,18">
            <TextBlock Text="Your password is encrypted using Windows Local Security Authority (LSA) and readable only by system security. It enables Peek to automatically unlock Windows when face verification succeeds."
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       LineHeight="17" />
        </Border>

        <!-- Password Input Form -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Current Password"
                       FontWeight="Medium"
                       FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,6" />
            <PasswordBox x:Name="PasswordInput"
                         Style="{StaticResource ModernPasswordBoxStyle}"
                         Margin="0,0,0,8"
                         KeyDown="PasswordInput_KeyDown" />

            <!-- Error Banner -->
            <Border x:Name="ErrorBorder"
                    Background="{DynamicResource DangerBgBrush}"
                    BorderBrush="{DynamicResource DangerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,6"
                    Visibility="Collapsed"
                    Margin="0,4,0,0">
                <TextBlock x:Name="ErrorMessage"
                           Text="Incorrect password."
                           FontSize="12"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OnCancelClick"
                    IsCancel="True"
                    Margin="0,0,10,0"
                    MinWidth="90"
                    Height="40" />

            <Button Grid.Column="2"
                    x:Name="LinkButton"
                    Content="Link Password"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnLinkClick"
                    IsDefault="True"
                    MinWidth="130"
                    Height="40" />
        </Grid>
    </Grid>
</Window>
