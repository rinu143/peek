<Window x:Class="PeekSetup.LinkPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Link Windows Password"
        Width="460"
        MinWidth="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
        Topmost="True">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <!-- Scrollable Content Area -->
            <RowDefinition Height="*" />
            <!-- Fixed Bottom Docked Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Margin="0,0,0,16">
                <!-- Header -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Link Windows Password"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="TargetUserText"
                               Text="Account: Domain\User"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Explanation card -->
                <Border Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        Margin="0,0,0,16">
                    <TextBlock Text="Your password is encrypted using Windows Local Security Authority (LSA) and readable only by system security. It enables Peek to automatically unlock Windows when face verification succeeds."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="17" />
                </Border>

                <!-- Password Input Form -->
                <StackPanel>
                    <TextBlock Text="Current Password"
                               FontWeight="Medium"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <PasswordBox x:Name="PasswordInput"
                                 AutomationProperties.Name="Current Windows password"
                                 Style="{StaticResource ModernPasswordBoxStyle}"
                                 Margin="0,0,0,4"
                                 KeyDown="PasswordInput_KeyDown" />

                    <!-- Reserved Wrapping Area for Error Banner (Prevents Layout Jump) -->
                    <Grid MinHeight="36" Margin="0,4,0,0">
                        <Border x:Name="ErrorBorder"
                                Background="{DynamicResource DangerBgBrush}"
                                BorderBrush="{DynamicResource DangerBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,6"
                                Visibility="Collapsed">
                            <TextBlock x:Name="ErrorMessage"
                                       AutomationProperties.LiveSetting="Polite"
                                       Text="Incorrect password."
                                       FontSize="12"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Docked Bottom Buttons -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Cancel"
                    AutomationProperties.Name="Cancel password linking"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OnCancelClick"
                    IsCancel="True"
                    Margin="0,0,10,0"
                    MinWidth="90"
                    Height="40" />

            <Button Grid.Column="2"
                    x:Name="LinkButton"
                    Content="Link Password"
                    AutomationProperties.Name="Link Windows password"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnLinkClick"
                    IsDefault="True"
                    MinWidth="130"
                    Height="40" />
        </Grid>
    </Grid>
</Window>
