<Window x:Class="PeekSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PeekSetup.ViewModels"
        mc:Ignorable="d"
        Title="Face Recognition Setup"
        Icon="assets/peek.ico"
        Height="690" Width="720"
        MinHeight="560" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="36,20,36,20">
        <Grid.RowDefinitions>
            <!-- Minimal System Header & Progress Dots -->
            <RowDefinition Height="Auto" />
            <!-- Centered Scrollable Stage Area -->
            <RowDefinition Height="*" />
            <!-- Fixed Bottom Docked Action Area (Never clipped or scrolled away) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- ROW 0: MINIMAL SYSTEM HEADER & PAGINATION DOTS (ONBOARDING ONLY) -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16"
              Visibility="{Binding ShowStepIndicator, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Identity (Quiet & Clean) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{DynamicResource AppLogoSource}" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
                <TextBlock Text="Peek" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Apple-Style Step Indicator (Interactive Dynamic Pills) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Step 1: Welcome -->
                <Rectangle RadiusX="3.5" RadiusY="3.5" Margin="0,0,6,0">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Width" Value="7" />
                            <Setter Property="Height" Value="7" />
                            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWelcomeStep}" Value="True">
                                    <Setter Property="Width" Value="20" />
                                    <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!-- Step 2: Face Scan -->
                <Rectangle RadiusX="3.5" RadiusY="3.5" Margin="0,0,6,0">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Width" Value="7" />
                            <Setter Property="Height" Value="7" />
                            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnrollmentStep}" Value="True">
                                    <Setter Property="Width" Value="20" />
                                    <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!-- Step 3: Password Link -->
                <Rectangle RadiusX="3.5" RadiusY="3.5" Margin="0,0,6,0">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Width" Value="7" />
                            <Setter Property="Height" Value="7" />
                            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPasswordLinkStep}" Value="True">
                                    <Setter Property="Width" Value="20" />
                                    <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!-- Step 4: Done -->
                <Rectangle RadiusX="3.5" RadiusY="3.5">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Width" Value="7" />
                            <Setter Property="Height" Value="7" />
                            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDoneStep}" Value="True">
                                    <Setter Property="Width" Value="20" />
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
            </StackPanel>
        </Grid>

        <!-- ============================================================== -->
        <!-- ROW 1: SCROLLABLE STAGE AREA                                  -->
        <!-- ============================================================== -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <Grid MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                  VerticalAlignment="Stretch">

                <!-- STATE: CHECKING CONFIGURATION -->
                <Grid Visibility="{Binding IsCheckingStatus, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="180" Height="3" Style="{StaticResource ModernProgressBarStyle}" Margin="0,0,0,20" />
                        <TextBlock Text="Checking configuration..." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- SCREEN: ALREADY ENROLLED (PROFILE SECTION MATCHING SCREENSHOT) -->
                <Grid Visibility="{Binding IsAlreadyEnrolledStep, Converter={StaticResource BoolToVis}}"
                      VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Width="480" MaxWidth="520" Margin="0,12,0,12">

                        <!-- 1. "Face encrypted" Card -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="18" Padding="20,16" Margin="0,0,0,18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeoLock}" Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeThickness="1.5" Stretch="Uniform" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Face encrypted" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Enroll separate identities to use Peek with different looks (such as glasses), facial expressions, or new team members. This improves recognition quality."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 2. "Identities" Header with '+' Button -->
                        <Grid Margin="2,0,2,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Identities" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource CircleIconButtonStyle}"
                                    Command="{Binding StartAddIdentityCommand}"
                                    ToolTip="Add Identity" Width="28" Height="28"
                                    AutomationProperties.Name="Add face identity">
                                <Path Data="{StaticResource GeoPlus}" Stroke="{DynamicResource TextPrimaryBrush}"
                                      StrokeThickness="1.8" Stretch="Uniform" Width="11" Height="11"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </Grid>

                        <!-- 3. Password Verification Card (when adding new identity) -->
                        <Border Visibility="{Binding IsAddingNewIdentity, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1.5" CornerRadius="18" Padding="22,20" Margin="0,0,0,18">
                            <StackPanel>
                                <!-- Substep A: Enter System Password -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPasswordVerifiedForAdd}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Verify System Password" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource MinimalCloseButtonStyle}" Command="{Binding CancelAddIdentityCommand}"
                                                HorizontalAlignment="Right" Width="24" Height="24" ToolTip="Cancel">
                                            <Path Data="M 6,6 L 14,14 M 14,6 L 6,14" Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.6" Stretch="Uniform" Width="10" Height="10" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="Enter your Windows password to authorize adding a new face identity."
                                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" LineHeight="18" />

                                    <PasswordBox x:Name="NewIdentityPasswordBox"
                                                 PasswordChanged="NewIdentityPasswordBox_PasswordChanged"
                                                 KeyDown="NewIdentityPasswordBox_KeyDown"
                                                 IsVisibleChanged="NewIdentityPasswordBox_IsVisibleChanged"
                                                 Style="{StaticResource ModernPasswordBoxStyle}"
                                                 Height="42" FontSize="14" Margin="0,0,0,8"
                                                 TabIndex="1" />

                                    <TextBlock Text="{Binding PasswordVerificationError}"
                                               Foreground="{DynamicResource DangerBrush}" FontSize="12"
                                               Visibility="{Binding HasPasswordVerificationError, Converter={StaticResource BoolToVis}}"
                                               Margin="0,0,0,10" />

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding CancelAddIdentityCommand}"
                                                Content="Cancel" Height="36" Padding="18,0" Margin="0,0,10,0"
                                                FontSize="13" TabIndex="2" />
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding VerifyPasswordForAddCommand}"
                                                Content="Verify" Height="36" Padding="24,0"
                                                FontSize="13" TabIndex="3"
                                                IsEnabled="{Binding CanVerifyPasswordForAdd, FallbackValue=True}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Substep B: Enter Name & Start Enrollment -->
                                <StackPanel Visibility="{Binding IsPasswordVerifiedForAdd, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Add Face Identity" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource MinimalCloseButtonStyle}" Command="{Binding CancelAddIdentityCommand}"
                                                HorizontalAlignment="Right" Width="24" Height="24" ToolTip="Cancel">
                                            <Path Data="M 6,6 L 14,14 M 14,6 L 6,14" Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.6" Stretch="Uniform" Width="10" Height="10" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="Enter a name for this identity (e.g. With Glasses, Work, or Name):"
                                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" LineHeight="18" />

                                    <TextBox x:Name="NewIdentityNameBox"
                                             Text="{Binding NewIdentityName, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="NewIdentityNameBox_KeyDown"
                                             IsVisibleChanged="NewIdentityNameBox_IsVisibleChanged"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Height="42" FontSize="14" Margin="0,0,0,8"
                                             TabIndex="1" />

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding CancelAddIdentityCommand}"
                                                Content="Cancel" Height="36" Padding="18,0" Margin="0,0,10,0"
                                                FontSize="13" TabIndex="2" />
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding ConfirmAddIdentityCommand}"
                                                Content="Enroll Face" Height="36" Padding="24,0"
                                                FontSize="13" TabIndex="3" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 4. Identities List -->
                        <ItemsControl ItemsSource="{Binding Identities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="18" Padding="18,14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <!-- Top Row: Name Pill (or inline Edit Box) + Toggle -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Static Pill Badge (Display Mode) -->
                                                <Border Grid.Column="0" CornerRadius="12" Background="{DynamicResource PillBgBrush}"
                                                        Padding="14,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditingName}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </Border>

                                                <!-- Inline Edit Form (Edit Mode) -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditingName}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBox Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource ModernTextBoxStyle}"
                                                             FontSize="13" FontWeight="SemiBold"
                                                             Height="32" Width="180"
                                                             Padding="10,0"
                                                             VerticalContentAlignment="Center"
                                                             KeyDown="EditNameBox_KeyDown"
                                                             IsVisibleChanged="EditNameBox_IsVisibleChanged"
                                                             AutomationProperties.Name="Edit identity name input" />
                                                    <Button Style="{StaticResource CircleIconButtonStyle}"
                                                            Command="{Binding SaveEditCommand}"
                                                            ToolTip="Save name (Enter)"
                                                            Width="28" Height="28" Margin="6,0,0,0"
                                                            AutomationProperties.Name="Save name">
                                                        <Path Data="{StaticResource GeoCheck}" Stroke="{DynamicResource SuccessBrush}"
                                                              StrokeThickness="2" Stretch="Uniform" Width="11" Height="11"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                    <Button Style="{StaticResource CircleIconButtonStyle}"
                                                            Command="{Binding CancelEditCommand}"
                                                            ToolTip="Cancel (Esc)"
                                                            Width="28" Height="28" Margin="4,0,0,0"
                                                            AutomationProperties.Name="Cancel editing">
                                                        <Path Data="{StaticResource GeoCloseSmall}" Stroke="{DynamicResource TextSecondaryBrush}"
                                                              StrokeThickness="1.5" Stretch="Uniform" Width="10" Height="10"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                </StackPanel>

                                                <!-- Apple Toggle Switch -->
                                                <CheckBox Grid.Column="1" Style="{StaticResource AppleToggleSwitchStyle}"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          AutomationProperties.Name="Toggle identity enabled state"
                                                          VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Bottom Row: Quality Equalizer + Actions -->
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Quality Equalizer (Theme Aware) -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CaptureQualityText}" FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                                    <ItemsControl ItemsSource="{Binding QualityBars}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Rectangle Width="3.5" Height="17" RadiusX="1.75" RadiusY="1.75" Margin="0,0,2.5,0">
                                                                    <Rectangle.Style>
                                                                        <Style TargetType="Rectangle">
                                                                            <Setter Property="Fill" Value="{DynamicResource PillBgBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                    <Setter Property="Fill" Value="{Binding FillBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Rectangle.Style>
                                                                </Rectangle>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- Actions: Recapture + Edit Name + Delete (In Black Circled Area) -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                    <Button Style="{StaticResource RecaptureButtonStyle}"
                                                            Command="{Binding RecaptureCommand}"
                                                            Content="Recapture"
                                                            Margin="0,0,8,0"
                                                            AutomationProperties.Name="Recapture identity face" />
                                                    <Button Style="{StaticResource CircleIconButtonStyle}"
                                                            Command="{Binding BeginEditCommand}"
                                                            ToolTip="Edit identity name"
                                                            Margin="0,0,8,0"
                                                            AutomationProperties.Name="Edit identity name">
                                                        <Path Data="{StaticResource GeoPencil}" Stroke="{DynamicResource TextSecondaryBrush}"
                                                              StrokeThickness="1.5" Stretch="Uniform" Width="13" Height="13"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                    <Button Style="{StaticResource CircleIconButtonStyle}"
                                                            Command="{Binding DeleteCommand}"
                                                            ToolTip="Delete identity"
                                                            AutomationProperties.Name="Delete identity">
                                                        <Path Data="{StaticResource GeoTrash}" Stroke="{DynamicResource TextSecondaryBrush}"
                                                              StrokeThickness="1.5" Stretch="Uniform" Width="13" Height="13"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Grid>

                <!-- STEP 1: WELCOME & NAME -->
                <Grid Visibility="{Binding IsWelcomeStep, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                        <!-- Peek Biometric Logo (frame_search_1) -->
                        <Image Source="{DynamicResource AppLogoSource}" Width="64" Height="64"
                               HorizontalAlignment="Center" Margin="0,0,0,18"
                               RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />

                        <TextBlock Text="Set Up Face Recognition" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Position your face in front of the camera to unlock your PC quickly and securely."
                                   FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24" LineHeight="20" />

                        <!-- Display Name Field -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="Your Name" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                <TextBox x:Name="WelcomeDisplayNameBox"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Your name"
                                         KeyDown="WelcomeDisplayNameBox_KeyDown"
                                         Height="44" FontSize="14" TabIndex="1" />
                                <TextBlock Text="How Peek will address you at sign-in." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="2,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- STEP 2: FACE ENROLLMENT (BLACK ROUNDED CARD STAGE IN BOTH LIGHT AND DARK THEMES) -->
                <Grid Visibility="{Binding IsEnrollmentStep, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Background="#000000" CornerRadius="28" Padding="28,24" MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <!-- Top-Right Apple Face ID Dismiss '✕' Button -->
                            <Button Style="{StaticResource MinimalCloseButtonStyle}"
                                    Command="{Binding CancelEnrollmentCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Width="32" Height="32" Margin="0,-6,-6,0"
                                    ToolTip="Cancel Face Setup"
                                    AutomationProperties.Name="Cancel Face Setup"
                                    Panel.ZIndex="30">
                                <Path Data="M 8,8 L 16,16 M 16,8 L 8,16"
                                      Stroke="#FFFFFF" Opacity="0.85"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>

                            <!-- 2A. Connecting State -->
                            <Grid Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center" MinHeight="360" MinWidth="340">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True" Width="180" Height="3" Style="{StaticResource ModernProgressBarStyle}" Margin="0,0,0,20" />
                                    <TextBlock Text="Starting camera..." FontSize="15" FontWeight="Medium" HorizontalAlignment="Center" Foreground="#FFFFFF" />
                                </StackPanel>
                            </Grid>

                            <!-- 2B. Engine Unavailable State (Friendly Message + Expandable Technical Details) -->
                            <Grid Visibility="{Binding IsEngineUnavailable, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" MinHeight="360">
                                <Border Background="#1C1C1E" BorderBrush="#2C2C2E"
                                        BorderThickness="1" CornerRadius="20" Padding="28">
                                    <StackPanel>
                                        <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource WarningBgBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                                            <Path Data="{StaticResource GeoWarning}" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Text="Engine Not Running" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" Foreground="#FFFFFF" />
                                        <TextBlock Text="Peek couldn't connect to the local background service. Start it and try again."
                                                   FontSize="13" Foreground="#A1A1A6" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18" Margin="0,0,0,14" />

                                        <!-- Expandable Details Toggle -->
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding ToggleDetailsCommand}"
                                                Content="{Binding DetailsToggleText}"
                                                Visibility="{Binding HasTechnicalDetails, Converter={StaticResource BoolToVis}}"
                                                HorizontalAlignment="Center"
                                                Height="28" Padding="12,4" FontSize="11" Margin="0,0,0,10"
                                                AutomationProperties.Name="Toggle technical details" />

                                        <!-- Capped Inner ScrollViewer with Selectable/Copyable TextBox -->
                                        <Border Background="#2C2C2E" CornerRadius="8" Padding="8" MaxHeight="120"
                                                Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                                <TextBox Text="{Binding RawTechnicalDetails, Mode=OneWay}"
                                                         IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                                                         Foreground="#E5E5EA" FontFamily="Consolas, Cascadia Code, monospace" FontSize="11" />
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 2C. Failed State (Friendly Message + Expandable Technical Details) -->
                            <Grid Visibility="{Binding IsEnrollmentFailed, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" MinHeight="360">
                                <Border Background="#1C1C1E" BorderBrush="#2C2C2E"
                                        BorderThickness="1" CornerRadius="20" Padding="28">
                                    <StackPanel>
                                        <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource DangerBgBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                                            <Path Data="{StaticResource GeoError}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Text="Enrollment Incomplete" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" Foreground="#FFFFFF" />
                                        <TextBlock Text="{Binding EngineErrorMessage}"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   FontSize="13" Foreground="#A1A1A6" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14" />

                                        <!-- Expandable Details Toggle -->
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding ToggleDetailsCommand}"
                                                Content="{Binding DetailsToggleText}"
                                                Visibility="{Binding HasTechnicalDetails, Converter={StaticResource BoolToVis}}"
                                                HorizontalAlignment="Center"
                                                Height="28" Padding="12,4" FontSize="11" Margin="0,0,0,10"
                                                AutomationProperties.Name="Toggle technical details" />

                                        <!-- Capped Inner ScrollViewer with Selectable/Copyable TextBox -->
                                        <Border Background="#2C2C2E" CornerRadius="8" Padding="8" MaxHeight="120"
                                                Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                                <TextBox Text="{Binding RawTechnicalDetails, Mode=OneWay}"
                                                         IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                                                         Foreground="#E5E5EA" FontFamily="Consolas, Cascadia Code, monospace" FontSize="11" />
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 2D. Active Apple Face ID Viewport View (Clean Aperture + 72 Ticks + Chevron + Guidance) -->
                            <Grid Visibility="{Binding IsEnrolling, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <!-- Viewbox wraps aperture so it never clips and smoothly shrinks down on small windows/high DPI -->
                                    <Viewbox MaxWidth="340" MaxHeight="340" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                                        <Canvas Width="370" Height="370">

                                            <!-- 1. Apple Face ID 72 Radial Ticks (ItemsControl of Line elements) -->
                                            <ItemsControl ItemsSource="{Binding Ticks}" Width="370" Height="370" IsHitTestVisible="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="370" Height="370" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Line X1="{Binding X1}" Y1="{Binding Y1}"
                                                              X2="{Binding X2}" Y2="{Binding Y2}"
                                                              Stroke="{Binding StrokeBrush}"
                                                              Opacity="{Binding Opacity}"
                                                              StrokeThickness="2.8"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 2. Clean Camera Circular Aperture (296x296 centered at (37, 37)) -->
                                            <Border Canvas.Left="37" Canvas.Top="37"
                                                    Width="296" Height="296" CornerRadius="148" Background="#000000"
                                                    SnapsToDevicePixels="True" ClipToBounds="True">
                                                <Grid Width="296" Height="296">
                                                    <Grid.Clip>
                                                        <EllipseGeometry Center="148,148" RadiusX="148" RadiusY="148" />
                                                    </Grid.Clip>
                                                    <!-- Clean Camera Stream Frame -->
                                                    <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                    <!-- Camera Starting Placeholder -->
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Path Data="{StaticResource GeoCamera}" Stroke="#8E8E93" StrokeThickness="1.5" Stretch="Uniform" Width="32" Height="32" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                                        <TextBlock Text="Starting camera..." FontSize="13" Foreground="#8E8E93" HorizontalAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- Debug Overlay: Landmarks & Biometric Mesh -->
                                                    <Canvas Width="296" Height="296" IsHitTestVisible="False"
                                                            Visibility="{Binding ShowDebugOverlay, Converter={StaticResource BoolToVis}}">
                                                        <Path Data="{Binding BiometricMeshPathData}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Opacity="0.4" />
                                                        <Ellipse Canvas.Left="{Binding LeftEyeCanvasLeft}" Canvas.Top="{Binding LeftEyeCanvasTop}" Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Opacity="0.85" />
                                                        <Ellipse Canvas.Left="{Binding RightEyeCanvasLeft}" Canvas.Top="{Binding RightEyeCanvasTop}" Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Opacity="0.85" />
                                                        <Ellipse Canvas.Left="{Binding NoseCanvasLeft}" Canvas.Top="{Binding NoseCanvasTop}" Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Opacity="0.85" />
                                                        <Ellipse Canvas.Left="{Binding LeftMouthCanvasLeft}" Canvas.Top="{Binding LeftMouthCanvasTop}" Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Opacity="0.85" />
                                                        <Ellipse Canvas.Left="{Binding RightMouthCanvasLeft}" Canvas.Top="{Binding RightMouthCanvasTop}" Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Opacity="0.85" />
                                                    </Canvas>

                                                    <!-- Debug Overlay: Subtle Face ID Corner Brackets -->
                                                    <Canvas Width="296" Height="296" IsHitTestVisible="False"
                                                            Visibility="{Binding ShowDebugOverlay, Converter={StaticResource BoolToVis}}">
                                                        <Path Canvas.Left="{Binding FaceBboxLeft}"
                                                              Canvas.Top="{Binding FaceBboxTop}"
                                                              Data="{Binding CornerBracketsData}"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Visibility="{Binding IsFaceDetected, Converter={StaticResource BoolToVis}}">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsBracketGreen}" Value="True">
                                                                            <Setter Property="Stroke" Value="{DynamicResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Canvas>

                                                    <!-- Apple Face ID Directional Double Chevron Arrow (Centered Over Face in Camera Window) -->
                                                    <Grid Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Visibility="{Binding IsDirectionArrowVisible, Converter={StaticResource BoolToVis}}"
                                                          RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                                        <Grid.Effect>
                                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.75" />
                                                        </Grid.Effect>
                                                        <Grid.RenderTransform>
                                                            <TransformGroup>
                                                                <TranslateTransform x:Name="DirectionArrowTranslate" Y="0" />
                                                                <RotateTransform Angle="{Binding DirectionArrowAngle}" />
                                                            </TransformGroup>
                                                        </Grid.RenderTransform>
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsReducedMotion}" Value="False">
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)"
                                                                                                     From="0" To="-7" Duration="0:0:0.65">
                                                                                        <DoubleAnimation.EasingFunction>
                                                                                            <QuadraticEase EasingMode="EaseInOut" />
                                                                                        </DoubleAnimation.EasingFunction>
                                                                                    </DoubleAnimation>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Path Data="M 14,24 L 32,8 L 50,24 M 14,40 L 32,24 L 50,40"
                                                              StrokeThickness="5"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Stroke" Value="#FFFFFF" />
                                                                    <Setter Property="Opacity" Value="0.95" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPoseMatched}" Value="True">
                                                                            <Setter Property="Stroke" Value="#0A84FF" />
                                                                            <Setter Property="Opacity" Value="0.65" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Grid>

                                                    <!-- Pose Completion Flash Overlay -->
                                                    <Rectangle Width="296" Height="296" Fill="#FFFFFF" Opacity="0.55" IsHitTestVisible="False"
                                                               Visibility="{Binding IsPoseFlashActive, Converter={StaticResource BoolToVis}}" />

                                                    <!-- Pose Completion Checkmark Overlay -->
                                                    <Grid Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                                          Visibility="{Binding IsPoseCheckActive, Converter={StaticResource BoolToVis}}">
                                                        <Border CornerRadius="32" Background="#1C3829" BorderBrush="#30D158" BorderThickness="2" />
                                                        <Path Data="{StaticResource GeoCheck}" Stroke="#30D158" StrokeThickness="3" Stretch="Uniform" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>

                                                    <!-- Debug Overlay: Central Target Focus Reticle -->
                                                    <Canvas Width="296" Height="296" IsHitTestVisible="False"
                                                            Visibility="{Binding ShowDebugOverlay, Converter={StaticResource BoolToVis}}">
                                                        <Grid Canvas.Left="{Binding CenterReticleCanvasLeft}"
                                                              Canvas.Top="{Binding CenterReticleCanvasTop}"
                                                              Width="70" Height="70"
                                                              Visibility="{Binding IsCenterTarget, Converter={StaticResource BoolToVis}}">
                                                            <Ellipse Width="60" Height="60" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeDashArray="3 3" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>

                                                        <!-- Radar Beacon -->
                                                        <Grid Canvas.Left="{Binding TargetBeaconCanvasLeft}"
                                                              Canvas.Top="{Binding TargetBeaconCanvasTop}"
                                                              Width="20" Height="20"
                                                              RenderTransformOrigin="0.5,0.5"
                                                              Visibility="{Binding IsDirectionalTarget, Converter={StaticResource BoolToVis}}">
                                                            <Grid.RenderTransform>
                                                                <RotateTransform Angle="{Binding TargetAngleDegrees}" />
                                                            </Grid.RenderTransform>
                                                            <Ellipse Width="20" Height="20" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2" StrokeDashArray="2 2" Opacity="0.75" />
                                                            <Path Data="M 7,6 L 13,10 L 7,14" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>

                                                        <!-- Target Dot -->
                                                        <Grid Canvas.Left="{Binding TargetDotCanvasLeft}"
                                                              Canvas.Top="{Binding TargetDotCanvasTop}"
                                                              Width="10" Height="10"
                                                              Visibility="{Binding IsTargetDotVisible, Converter={StaticResource BoolToVis}}">
                                                            <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" Stroke="#FFFFFF" StrokeThickness="1.5" />
                                                        </Grid>
                                                    </Canvas>
                                                </Grid>
                                            </Border>
                                        </Canvas>
                                    </Viewbox>

                                    <!-- Apple Face ID Centered Live Guidance Typography (One Clean Line Under Ring) -->
                                    <TextBlock Text="{Binding FriendlyGuidanceText}"
                                               FontSize="22" FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="460"
                                               Margin="0,24,0,8"
                                               AutomationProperties.LiveSetting="Polite" />

                                    <!-- Debug Only: Secondary Status Pill, Beads, and 9-Pose Track -->
                                    <StackPanel Visibility="{Binding ShowDebugOverlay, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                        <Border CornerRadius="14" Background="#1C1C1E" BorderBrush="#2C2C2E" BorderThickness="1" Padding="14,6" Margin="0,0,0,14" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{Binding CurrentPoseIconData}" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding TargetPoseName}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding PoseStatusBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="#30D158" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Apple-Style 9-Pose Segmented Progress Track with Directional Mini-Icons -->
                                        <StackPanel Width="340" HorizontalAlignment="Center">
                                            <ItemsControl ItemsSource="{Binding Poses}" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="32" Height="24" CornerRadius="6" Margin="0,0,4,0" ToolTip="{Binding Label}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#2C2C2E" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Background" Value="#1C3829" />
                                                                            <Setter Property="BorderBrush" Value="#30D158" />
                                                                            <Setter Property="BorderThickness" Value="1" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Background" Value="#3A3A3C" />
                                                                            <Setter Property="BorderBrush" Value="#0A84FF" />
                                                                            <Setter Property="BorderThickness" Value="1.5" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource GeoCheck}" Stroke="#30D158" StrokeThickness="2" Stretch="Uniform" Width="11" Height="11"
                                                                      Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />
                                                                <Path Data="{Binding IconData}" Fill="#0A84FF" Stretch="Uniform" Width="12" Height="12"
                                                                      Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                                                <Ellipse Width="4" Height="4" Fill="#8E8E93"
                                                                         Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Overall Progress Bar + Percent Indicator -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0" Value="{Binding ProgressPercentage, Mode=OneWay}"
                                                             Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Height="4" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding ProgressPercentageText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#A1A1A6" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>

                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- STEP 3: MANDATORY PASSWORD LINKING -->
                <Grid Visibility="{Binding IsPasswordLinkStep, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                        <!-- Key Glyph -->
                        <Border Width="60" Height="60" CornerRadius="30" Background="{DynamicResource PillBgBrush}" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <Path Data="{StaticResource GeoKey}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="Link Windows Password" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Link your Windows password so your PC unlocks automatically the instant your face is recognized. Password linking is required to complete setup."
                                   FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20" LineHeight="20" />

                        <!-- Security Note Card -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,16">
                            <TextBlock Text="Your password is encrypted using Windows Local Security Authority (LSA) and readable only by system security. Your regular Windows password and PIN will always remain available."
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="17" />
                        </Border>

                        <!-- Error Message Banner (if any) with Technical Details -->
                        <Border Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14,10"
                                Visibility="{Binding HasPasswordError, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding PasswordErrorMessage}"
                                           AutomationProperties.LiveSetting="Polite"
                                           FontSize="12" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />

                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ToggleDetailsCommand}"
                                        Content="{Binding DetailsToggleText}"
                                        Visibility="{Binding HasTechnicalDetails, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Left"
                                        Height="24" Padding="8,2" FontSize="11" Margin="0,6,0,0"
                                        AutomationProperties.Name="Toggle technical details" />

                                <Border Background="{DynamicResource PillBgBrush}" CornerRadius="6" Padding="6" MaxHeight="100"
                                        Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BoolToVis}}"
                                        Margin="0,6,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                        <TextBox Text="{Binding RawTechnicalDetails, Mode=OneWay}"
                                                 IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas, monospace" FontSize="11" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- STEP 4: COMPLETE -->
                <Grid Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                        <!-- Clean Emerald Checkmark Circle -->
                        <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource SuccessBgBrush}"
                                BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1.5"
                                HorizontalAlignment="Center" Margin="0,0,0,18">
                            <Path Data="{StaticResource GeoCheck}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2" Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="Face Recognition Is Ready" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="You can now use your face to unlock this PC at the lock screen."
                                   FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24" />

                        <!-- Quiet Summary Card -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Account" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding EnrolledDisplayName}" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,12" />
                                <Grid>
                                    <TextBlock Text="Sign-in Mode" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding UnlockBadgeText}" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

            </Grid>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- ROW 2: FIXED DOCKED ACTIONS BAR (NEVER SCROLLED AWAY)          -->
        <!-- ============================================================== -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <!-- 2. Welcome Step Actions -->
            <Grid Visibility="{Binding IsWelcomeStep, Converter={StaticResource BoolToVis}}"
                  HorizontalAlignment="Center" Width="440">
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding BeginEnrollmentCommand}"
                        Content="Get Started"
                        Height="46" FontSize="15" TabIndex="2"
                        AutomationProperties.Name="Get started with setup" />
            </Grid>

            <!-- 3. Face Enrollment Step Actions -->
            <Grid Visibility="{Binding IsEnrollmentStep, Converter={StaticResource BoolToVis}}"
                  HorizontalAlignment="Center" Width="440">
                <!-- 3A. Connecting State: Cancel -->
                <Button Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelEnrollmentCommand}"
                        Content="Cancel"
                        Width="140" Height="40" HorizontalAlignment="Center"
                        Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                        AutomationProperties.Name="Cancel enrollment" />

                <!-- 3B. Engine Unavailable: Back and Retry -->
                <Grid Visibility="{Binding IsEngineUnavailable, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding BackToWelcomeCommand}" Content="Back" Height="42"
                            AutomationProperties.Name="Back to welcome screen" />
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding RetryConnectionCommand}" Content="Retry" Height="42"
                            AutomationProperties.Name="Retry connection to engine" />
                </Grid>

                <!-- 3C. Failed State: Back and Try Again -->
                <Grid Visibility="{Binding IsEnrollmentFailed, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding BackToWelcomeCommand}" Content="Back" Height="42"
                            AutomationProperties.Name="Back to welcome screen" />
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding RetryEnrollmentCommand}" Content="Try Again" Height="42"
                            AutomationProperties.Name="Try enrollment again" />
                </Grid>

                <!-- 3D. Active Enrolling: Cancel -->
                <Button Visibility="{Binding IsEnrolling, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelEnrollmentCommand}"
                        Content="Cancel"
                        Width="140" Height="40" HorizontalAlignment="Center"
                        Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                        AutomationProperties.Name="Cancel enrollment" />
            </Grid>

            <!-- 4. Mandatory Password Link Actions -->
            <Grid Visibility="{Binding IsPasswordLinkStep, Converter={StaticResource BoolToVis}}"
                  HorizontalAlignment="Center" Width="440">
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding LinkPasswordElevatedCommand}"
                        IsEnabled="{Binding CanLinkPassword}"
                        Content="Link Password"
                        Height="46" FontSize="14"
                        AutomationProperties.Name="Link Windows password" />
            </Grid>

            <!-- 5. Complete Step Actions -->
            <Grid Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVis}}"
                  HorizontalAlignment="Center" Width="440">
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding GoToProfileSectionCommand}"
                        Content="Manage Profiles"
                        Height="46" FontSize="15"
                        AutomationProperties.Name="Manage enrolled identities" />
            </Grid>
        </Grid>

    </Grid>
</Window>
