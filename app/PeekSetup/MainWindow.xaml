<Window x:Class="PeekSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PeekSetup.ViewModels"
        mc:Ignorable="d"
        Title="Peek — Face Setup"
        Height="730" Width="780"
        MinHeight="700" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <!-- Top Header & Step Progress -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Footer / Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Logo -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                    <!-- Stylized Eye / Peek Glyphs -->
                    <Path Data="M 7,18 C 11,10 25,10 29,18 C 25,26 11,26 7,18 Z M 18,14 C 15.8,14 14,15.8 14,18 C 14,20.2 15.8,22 18,22 C 20.2,22 22,20.2 22,18 C 22,15.8 20.2,14 18,14 Z"
                          Fill="#FFFFFF" Stretch="Uniform" Margin="7" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Peek" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Facial Recognition Setup" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Step Wizard Indicator -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Step 1 Indicator -->
                <Border x:Name="PillStep1" CornerRadius="12" Padding="12,5" Margin="0,0,6,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1C1C22" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWelcomeStep}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="1. Welcome" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                </Border>

                <!-- Step 2 Indicator -->
                <Border x:Name="PillStep2" CornerRadius="12" Padding="12,5" Margin="0,0,6,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1C1C22" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnrollmentStep}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="2. Face Scan" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                </Border>

                <!-- Step 3 Indicator -->
                <Border x:Name="PillStep3" CornerRadius="12" Padding="12,5" Margin="0,0,6,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1C1C22" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPasswordLinkStep}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="3. Password" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                </Border>

                <!-- Step 4 Indicator -->
                <Border x:Name="PillStep4" CornerRadius="12" Padding="12,5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1C1C22" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDoneStep}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="4. Complete" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- ============================================================== -->
        <!-- MAIN CONTENT AREA                                             -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1">

            <!-- STEP 1: WELCOME & DETAILS -->
            <Grid Visibility="{Binding IsWelcomeStep, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                    <TextBlock Text="Welcome to Peek" FontSize="28" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="Guided facial enrollment allows you to securely sign in to your PC in milliseconds without typing passwords or PINs."
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,24" LineHeight="20" />

                    <!-- Feature Highlights Card -->
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,28">
                        <StackPanel>
                            <!-- Feature 1 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⚡" FontSize="18" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Instant Biometric Unlock" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="Look at the webcam at your lock screen to immediately authenticate." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <!-- Feature 2 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🛡️" FontSize="18" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Hardware-Backed DPAPI Encryption" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="Biometric templates and credentials are encrypted locally with Windows DPAPI and never leave your machine." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <!-- Feature 3 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔑" FontSize="18" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Full Fallback Assurance" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="Your standard Windows password and PIN will always remain functional." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Details Input -->
                    <StackPanel Margin="0,0,0,28">
                        <TextBlock Text="Your Display Name" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="15" />
                        <TextBlock Text="Pre-filled with your Windows account name. You can customize how Peek addresses you."
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="2,6,0,0" />
                    </StackPanel>

                    <!-- Begin Enrollment Button -->
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding BeginEnrollmentCommand}"
                            Content="Begin Face Enrollment"
                            Height="44" FontSize="15" />
                </StackPanel>
            </Grid>

            <!-- STEP 2: FACE ENROLLMENT -->
            <Grid Visibility="{Binding IsEnrollmentStep, Converter={StaticResource BoolToVis}}">

                <!-- 2A. Connecting State -->
                <Grid Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4" Style="{StaticResource ModernProgressBarStyle}" Margin="0,0,0,20" />
                        <TextBlock Text="Connecting to Peek camera engine..." FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Acquiring camera and preparing 9-pose guidance stream..." FontSize="13" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 2B. Engine Unavailable State -->
                <Grid Visibility="{Binding IsEngineUnavailable, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="28">
                        <StackPanel>
                            <Border Width="48" Height="48" CornerRadius="24" Background="#311F0B" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="⚠️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="Peek Engine Is Not Running" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Peek couldn't connect to \\.\pipe\PeekEnrollment. The background face engine service needs to be active for guided enrollment."
                                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18" Margin="0,0,0,16" />

                            <!-- Actionable hint box -->
                            <Border Background="#141418" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="To start the engine service, run this in a terminal:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="python scripts/run_engine_service.py" FontFamily="Consolas, monospace" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding BackToWelcomeCommand}" Content="Back to Welcome" Height="40" />
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding RetryConnectionCommand}" Content="Retry Connection" Height="40" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2C. Failed State -->
                <Grid Visibility="{Binding IsEnrollmentFailed, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="28">
                        <StackPanel>
                            <Border Width="48" Height="48" CornerRadius="24" Background="#311313" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="❌" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="Enrollment Incomplete" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding EngineErrorMessage}"
                                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding BackToWelcomeCommand}" Content="Back" Height="40" />
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding RetryEnrollmentCommand}" Content="Try Again" Height="40" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2D. Active Enrollment View -->
                <Grid Visibility="{Binding IsEnrolling, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                        <!-- Main Camera Container -->
                        <Border Width="560" Height="380" CornerRadius="12" Background="#0A0A0C"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                SnapsToDevicePixels="True" ClipToBounds="True">
                            <Grid>
                                <!-- Camera Feed Image -->
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <!-- Placeholder when waiting for first frame -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding PreviewImage, Converter={StaticResource BoolToVis}}">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="📷" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                    <TextBlock Text="Streaming camera feed..." FontSize="14" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- Top Overlay: Target Pose Pill -->
                                <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                                        CornerRadius="20" Background="#CC111116" BorderBrush="#40FFFFFF" BorderThickness="1"
                                        Padding="16,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PoseStepCounterText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="•" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding TargetPoseName}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                </Border>

                                <!-- Bottom Overlay: Guidance Text & Quality Pill -->
                                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                                        CornerRadius="16" Background="#DD111116" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                        Padding="16,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Quality Dot -->
                                        <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsQualityPassed}" Value="False">
                                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding GuidanceText}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Progress Bar & 9-Pose Step Indicator -->
                        <Grid Width="560" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <!-- 9 Pose Dots Container -->
                                <ItemsControl ItemsSource="{Binding Poses}" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="50" Height="6" CornerRadius="3" Margin="0,0,6,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#25252D" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}"
                                             Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Height="4" />
                            </StackPanel>

                            <!-- Progress Percent -->
                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercentageText}" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>

                        <!-- Cancel Button -->
                        <Button Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding CancelEnrollmentCommand}"
                                Content="Cancel Enrollment"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0" Width="180" Height="36" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- STEP 3: OPTIONAL PASSWORD LINKING -->
            <Grid Visibility="{Binding IsPasswordLinkStep, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="540">
                    <TextBlock Text="Link Windows Password" FontSize="26" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="Enable seamless, zero-interaction unlock at the Windows lock screen"
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20" />

                    <!-- Plain Language Explanation Card -->
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="Why link your password?" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
                            <TextBlock Text="When your face is recognized, Windows requires a credential to complete login. Linking your password allows Peek to supply it automatically, unlocking your desktop the instant you look at the camera."
                                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12" />

                            <Border Background="#141418" BorderBrush="#25252C" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Optional &amp; Secure: Stored exclusively DPAPI-wrapped on this PC."
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Password Input Form -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Current Windows Password" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                        <PasswordBox x:Name="PasswordInput"
                                     Style="{StaticResource ModernPasswordBoxStyle}"
                                     FontSize="16" Height="42"
                                     KeyDown="PasswordInput_KeyDown" />

                        <!-- Error Message if verification failed -->
                        <Border Background="#311313" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,8" Margin="0,10,0,0"
                                Visibility="{Binding HasPasswordError, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PasswordErrorMessage}" FontSize="12" Foreground="#FFAAAA" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Skip Option -->
                        <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SkipPasswordCommand}"
                                Content="Skip for Now" Height="44" />

                        <!-- Link Option -->
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnLinkPasswordClicked"
                                IsEnabled="{Binding CanLinkPassword}"
                                Content="Link Password &amp; Finish" Height="44" />
                    </Grid>

                    <TextBlock Text="Skipping leaves your face profile active. Windows will simply prompt for your PIN or password after recognizing you."
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>
            </Grid>

            <!-- STEP 4: SETUP COMPLETE -->
            <Grid Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                    <!-- Success Badge -->
                    <Border Width="64" Height="64" CornerRadius="32" Background="#113324"
                            BorderBrush="{StaticResource SuccessBrush}" BorderThickness="2"
                            HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="✓" FontSize="32" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Setup Complete!" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Your Peek biometric face profile is ready to use."
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,28" />

                    <!-- Profile Details Summary Card -->
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,24">
                        <StackPanel>
                            <!-- Name -->
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Profile Name" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding EnrolledDisplayName}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right" />
                            </Grid>

                            <Separator Background="{StaticResource CardBorderBrush}" Margin="0,0,0,12" />

                            <!-- Face Enrollment -->
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Biometrics" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="Enrolled (9 Poses Secured)" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right" />
                            </Grid>

                            <Separator Background="{StaticResource CardBorderBrush}" Margin="0,0,0,12" />

                            <!-- Unlock Mode -->
                            <Grid>
                                <TextBlock Text="Lock Screen Mode" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                                <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Right"
                                        Background="#1E293B">
                                    <TextBlock Text="{Binding UnlockBadgeText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding UnlockBadgeColor}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Fallback Notice Card -->
                    <Border Background="#141418" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,28">
                        <StackPanel>
                            <TextBlock Text="Fallback Assurance" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Text="Your regular Windows sign-in options (PIN and password) remain fully active. You can switch to them at any time from the lock screen."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="16" />
                        </StackPanel>
                    </Border>

                    <!-- Finish Button -->
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding FinishCommand}"
                            Content="Finish &amp; Close" Height="44" FontSize="15" />
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</Window>
